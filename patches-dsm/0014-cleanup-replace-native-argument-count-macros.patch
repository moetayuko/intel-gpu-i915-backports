+#define DEFINE_LOCK_GUARD_1_COND(X...) CONCATENATE(DEFINE_LOCK_GUARD_1_COND_, BACKPORT_COUNT_ARGS(X))(X)
 
 #endif /* _LINUX_CLEANUP_H */
