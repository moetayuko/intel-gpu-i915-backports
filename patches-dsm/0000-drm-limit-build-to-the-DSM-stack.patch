Subject: drm: limit the DSM build to the imported stack

Keep the shared DRM stack and i915. Reuse native MIPI-DSI and omit
unrelated drivers, tests and header checks from the external build.

--- a/drivers/gpu/drm/Makefile
+++ b/drivers/gpu/drm/Makefile
@@ -161,94 +161,6 @@
 # Drivers and the rest
 #
 
-obj-y			+= tests/
-
-obj-$(CONFIG_DRM_MIPI_DBI) += drm_mipi_dbi.o
-obj-$(CONFIG_DRM_MIPI_DSI) += drm_mipi_dsi.o
-obj-y			+= arm/
-obj-y			+= clients/
-obj-y			+= display/
-obj-$(CONFIG_DRM_TTM)	+= ttm/
