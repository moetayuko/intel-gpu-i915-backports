@@ -30,8 +30,20 @@
 static dma_addr_t gmch_ggtt_read_entry(struct i915_address_space *vm,
 				       u64 offset, bool *is_present, bool *is_local)
 {
+#if !IS_ENABLED(CPTCFG_INTEL_GTT_BACKPORT) && defined(BPM_INTEL_GMCH_GTT_READ_ENTRY_NOT_PRESENT)
+	struct i915_ggtt *ggtt = i915_vm_to_ggtt(vm);
+	u64 pte = readl((u32 __iomem *)ggtt->gsm + (offset >> PAGE_SHIFT));
+
+	/* Decode as i830_read_entry/i965_read_entry in the donor intel-gtt.c. */
+	*is_present = pte & BIT(0);
+	*is_local = false;
+	if (GRAPHICS_VER(vm->i915) >= 4)
+		return ((pte & 0xf0) << 28) | (pte & ~0xfffULL);
+	return pte & ~0xfffULL;
+#else
 	return intel_gmch_gtt_read_entry(offset >> PAGE_SHIFT,
 					 is_present, is_local);
+#endif
 }
 
