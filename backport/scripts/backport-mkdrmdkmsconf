#!/bin/sh
#
# Creates a dkms.conf file for RPM DKMS package
#

PKG_NAME="intel-i915-dkms"
PKG_VER="1.0"
REL_NAME="1"
BUILD_TYPE=""

helpFunction()
{
	echo ""
	echo "Usage: $0 -n packagename -v packageversion -r releaseversion -s buildversion"
	echo -e "\t-n packagename"
	echo -e "\t-v packageversion"
	echo -e "\t-r releaseversion"
	echo -e "\t-s buildversion"
	exit 1
}

while getopts "n:v:r:s:" opt
do
	case "$opt" in
		n ) PKG_NAME="$OPTARG" ;;
		v ) PKG_VER="$OPTARG" ;;
		r ) REL_NAME="$OPTARG" ;;
		s ) BUILD_TYPE="$OPTARG" ;;
		? ) helpFunction ;;
	esac
done

# Control below line by conditionally adding DEL at the beginning of line
# those lines will be disabled by sed
#
sed -e '/^DEL/d' -e 's/^\t*//' <<EOF
	PACKAGE_NAME="$PKG_NAME"
	PACKAGE_VERSION="$PKG_VER"
	AUTOINSTALL="yes"

	MAKE="export LEX=flex; export YACC=bison; KSRC=/usr/src/kernels/\\\$kernelver; if [ ! -d \\\$KSRC ]; then KSRC=/lib/modules/\\\$kernelver/build; fi; ./compile.sh compile \\\$KSRC"

	CLEAN="export LEX=flex; export YACC=bison; 'make' -C src clean 2>/dev/null || true; 'make' mrproper 2>/dev/null || true"

	BUILT_MODULE_NAME[0]="i915-compat"
	BUILT_MODULE_LOCATION[0]="src/compat"
	DEST_MODULE_LOCATION[0]="/updates"

	BUILT_MODULE_NAME[1]="i915"
	BUILT_MODULE_LOCATION[1]="src/drivers/gpu/drm/i915"
	DEST_MODULE_LOCATION[1]="/updates"

EOF
